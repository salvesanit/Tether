{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nightowls.example/tether/claim.schema.json",
  "title": "Tether candidate claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "text", "quote", "locator", "confidence"],
  "properties": {
    "type": {"enum": ["decision", "owner", "dependency", "risk", "repeated problem", "open question", "next step"]},
    "text": {"type": "string", "minLength": 1, "maxLength": 240},
    "quote": {"type": "string", "minLength": 1},
    "locator": {"type": "string", "pattern": "^(file:.+#(P[0-9]+|L[0-9]+-[0-9]+)|commit:[0-9a-f]{7,40}|issue:[0-9]+#(body|c[0-9]+)|pr:[0-9]+#(body|c[0-9]+)|chat:[^@]+@.+)$"},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "subject": {"type": ["string", "null"]},
    "attribute": {"type": ["string", "null"]},
    "value": {"type": ["string", "null"]},
    "rejected_options": {"type": "array", "items": {"type": "string"}},
    "reason": {"type": ["string", "null"]}
  }
}
